# Backend
NODE_ENV=development
PORT=3001
DATABASE_URL="file:./data/ts6webui.db"
JWT_SECRET=change-this-to-a-random-string-at-least-32-chars
# Required in production, must differ from JWT_SECRET (encrypts stored credentials)
ENCRYPTION_KEY=change-this-to-a-different-random-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
FRONTEND_URL=http://localhost:5173

# Media sidecar — shared secret between backend and sidecar HTTP API
SIDECAR_TOKEN=change-this-to-a-random-string

# Reverse-proxy (Authentik forward-auth) trusted-header SSO.
# When TRUST_PROXY_AUTH is on, the Login page shows a "Sign in with Authentik"
# button that logs in via the trusted X-authentik-username header the proxy sets.
# ONLY enable behind a proxy that authenticates the user and sets/overwrites these
# headers, and when the backend port is not otherwise reachable (header = identity).
# TRUST_PROXY_AUTH=true
# PROXY_AUTH_HEADER_USER=x-authentik-username
# PROXY_AUTH_HEADER_NAME=x-authentik-name
# Stable per-user id from the IdP; accounts are keyed on this so an Authentik
# username rename still maps to the same local account (falls back to the username).
# PROXY_AUTH_HEADER_UID=x-authentik-uid
# PROXY_AUTH_DEFAULT_ROLE=viewer

# Frontend (Vite env vars)
VITE_API_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001/ws
